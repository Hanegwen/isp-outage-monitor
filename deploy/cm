#!/bin/sh
# Run a monitor module by hand with the service's settings, e.g.:
#   sudo cm report --month 2026-10        sudo cm report --send        sudo cm speedtest
# install.sh fills in the service user; as root this re-runs itself as that user so files stay owned by it.
user=@SERVICE_USER@
if [ "$(id -u)" = 0 ] && [ "$user" != root ]; then
    exec runuser -u "$user" -- "$0" "$@"
fi
if [ ! -r /etc/comcast-monitor.env ]; then
    echo "cannot read /etc/comcast-monitor.env - run with sudo" >&2
    exit 1
fi
set -a
. /etc/comcast-monitor.env
set +a
[ $# -gt 0 ] || { echo "usage: cm report|speedtest|usage [options]" >&2; exit 2; }
cd /opt/comcast-monitor
mod="$1"; shift
exec python3 -m "monitor.$mod" "$@"
