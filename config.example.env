# install.sh copies this to /etc/comcast-monitor.env (owner root, group = the service user's group, mode 640).
# Edit that copy, never this file, and never commit the real one.
# One KEY=value per line; comments only on their own line. Quote values that contain spaces, e.g. SERVICE_ADDRESS="123 Main St, Springfield"

# Shown on the report and in the copy/paste text for Xfinity
CUSTOMER_NAME=
SERVICE_ADDRESS=
ACCOUNT_NUMBER=
# Plan name and advertised download speed (speed tests under half of PLAN_MBPS are flagged)
PLAN_NAME=
PLAN_MBPS=800
# What you pay per month, e.g. 80.00. Used for the credit estimate; leave blank to skip it.
MONTHLY_CHARGE=
# Optional temporary price (e.g. a 12-month discount), used only for report months FROM..UNTIL (YYYY-MM, inclusive)
#PROMO_CHARGE=
#PROMO_FROM=2026-01
#PROMO_UNTIL=2026-12
#PROMO_NOTE="promo price, ends Dec 2026"

# Who gets the report, and the Gmail account + app password that sends it
REPORT_TO=
SMTP_USER=
SMTP_APP_PASSWORD=

# Tuning (defaults shown)
#CHECK_INTERVAL=30
#MIN_OUTAGE_SECONDS=120
#GATEWAY_IP=192.168.1.1
#MODEM_IP=192.168.100.1
#INTERNET_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9

# Optional data-usage alerts (Netgear routers with Traffic Meter only, tested with an R7000).
# Router admin login; leave ROUTER_PASSWORD blank to turn the feature off. Sent as HTTP basic
# auth over plain HTTP on your LAN, so use a password you use nowhere else.
ROUTER_USER=admin
ROUTER_PASSWORD=
# Monthly data allowance in GB (Xfinity: 1200 = 1.2 TB)
DATA_CAP_GB=1200
#DAILY_ALERT_GB=60
#HOURLY_ALERT_GB=15
# Where pc/steam-report.ps1 drops its summary (that script writes the default path)
#STEAM_REPORT=/var/lib/comcast-monitor/steam.json

# Advanced (defaults shown)
#DB_PATH=/var/lib/comcast-monitor/monitor.db
#DNS_TEST_HOST=www.google.com
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
